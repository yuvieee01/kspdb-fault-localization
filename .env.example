# Copy to .env only when overriding the safe local defaults used by compose.
# Never commit .env. ANTHROPIC_API_KEY is optional: the app uses a
# deterministic briefing fallback when it is absent.
POSTGRES_USER=kspdb
POSTGRES_PASSWORD=kspdb_dev
POSTGRES_DB=kspdb
POSTGRES_PORT=5432
BACKEND_PORT=4000
FRONTEND_PORT=5173
# `PORT` and `SEED_IF_EMPTY` are set internally by compose/start:docker.
# They are listed here to make every runtime variable discoverable.
PORT=4000
SEED_IF_EMPTY=true
# Compose builds DATABASE_URL from the POSTGRES_* values. Set this only when
# running the backend outside compose (for example, with a hosted database).
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
VITE_API_BASE_URL=
